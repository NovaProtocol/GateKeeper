# GateKeeper environment variables.
# Documentation only — values come from compose interpolation or exported
# shell vars (house rule, see ~/Projects/agent_stuff/env.md). No .env file.

# --- Required (compose fails fast without them) ---

# Flask secret key for signing the auth cookie.
SECRET_KEY=change-me-to-a-random-string

# Basic-auth password for the /manage admin panel.
MANAGE_PASSWORD=change-me-too

# --- Optional ---

# Fallback access code; seeded as the "backup" row whenever that row is
# missing from the codes table. Empty = no backup code.
BACKUP_CODE=optional-fallback-code

# Where the SQLite DB lives. Compose sets this to /data (volume gatekeeper_data).
# Defaults to the app directory when unset.
DB_DIR=/data
