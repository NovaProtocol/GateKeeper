# GateKeeper environment variables.
# Documentation only — values come from compose interpolation or shell exports.
# No .env file — `compose.yaml` uses `${VAR:?}` / `${VAR:-}` strictly.

# --- Required (compose fails fast without them) ---

# Signing key for auth cookies (>=32 chars). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Basic-auth password for /manage admin panel.
MANAGE_PASSWORD=change-me-too

# Deployment mode: debug or production (lowercase).
DEPLOYMENT_TYPE=production

# --- Optional ---

# Fallback access code; seeded as "backup" row when missing.
BACKUP_CODE=optional-fallback-code

# SQLite dir (volume gatekeeper_data). Defaults to /data in compose.
DB_DIR=/data

# MySQL override (when set, api uses MySQL via aiomysql, phpmyadmin meaningful).
# Example: mysql+aiomysql://root:pass@mysql-db:3306/gatekeeper
DATABASE_URL=

# Shared internal key for api <-> auth-gateway <-> management (gRPC/HTTP). Generate: secrets.token_hex(32)
INTERNAL_API_KEY=change-me-internal

# MySQL vars (when using mysql-db)
MYSQL_PASS=change-me-mysql
MYSQL_DATABASE=gatekeeper

# Log retention days for audit_logs pruning.
LOG_RETENTION_DAYS=30
